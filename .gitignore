# Certificados e chaves gerados localmente (nunca versionar material criptográfico)
certs/*
!certs/.gitkeep

# Contextos OSCORE: carregam o master_secret compartilhado
oscore/*
!oscore/.gitkeep

# Chaves pré-compartilhadas dos canais: um segredo por classe de aplicação
keys/*
!keys/.gitkeep

# Resultados de execução: CSVs, manifestos e capturas
results/*
!results/.gitkeep
# Exceção: o compilado das campanhas é material do artigo, não dado bruto.
# São 25 kB gerados por scripts/planilha_resultados.py a partir dos resumo.csv,
# e é o que sobrevive quando os diretórios de campanha (centenas de MB) não
# vão para o repositório.
!results/resultados-compilados.xlsx

# Artefatos de compilação
build/
*.o
*.d
tls_server
tls_client
dtls_server
dtls_client

# Diversos
*.log
*.swp

# Material de terceiros usado como referência (PDFs com direitos autorais)
bench/

# Bytecode do Python dos scripts de agregação
__pycache__/
